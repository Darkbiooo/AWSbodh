# AWS Configuration for AWS Amplify Console (starts with APP_AWS_ to avoid reserved "AWS" prefix error)
APP_AWS_REGION=ap-southeast-2
APP_AWS_S3_BUCKET=regional-dsa-learning
APP_AWS_ACCESS_KEY_ID=your_access_key_id_here
APP_AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
APP_AWS_DYNAMODB_TABLE=bodh-students
APP_AWS_AUTH_TABLE=bodh-auth
APP_AWS_STUDENT_RECORD_TABLE=bodh-student-records

# Standard AWS environment variables (for local tools/SDK)
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=regional-dsa-learning
AWS_ACCESS_KEY_ID=your_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here
AWS_DYNAMODB_TABLE=bodh-students
AWS_AUTH_TABLE=bodh-auth
AWS_STUDENT_RECORD_TABLE=bodh-student-records

# Auth & Models
JWT_SECRET=your_jwt_secret_here
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
AUTH_SECRET=your_auth_secret_here
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
